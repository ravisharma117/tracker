# Copy to .env and fill in. .env is gitignored; this file is the template.
#
# Nothing here can be a secret even in principle: Vite inlines VITE_* values into
# the bundle at build time. The manage password is NOT here and never should be -
# it is typed into the lock screen, held in sessionStorage for the tab, and sent
# to the API per request.

# Origin of the naxits-api deployment, no trailing slash. Required: an empty
# value makes every API call fall through to the SPA redirect and return HTML.
# Use http://localhost:8888 to develop against a locally running API.
VITE_API_BASE_URL=https://naxits-api.netlify.app
