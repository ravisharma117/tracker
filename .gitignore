# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets. The server now holds real credentials — the Atlas connection string,
# the Cloudinary API secret and the manage password — so a committed .env would
# publish all three. `*.local` above only covers .env.local; plain .env needs
# saying. .env.example is the committed template and holds no values.
.env
.env.*
!.env.example

# Netlify CLI state (contains the linked site id)
.netlify

# Incremental build state written by `tsc -b` (npm run typecheck)
*.tsbuildinfo

# Server-managed PHP config kept only as a local reference. Carries the SMTP
# relay host and absolute log paths, so it stays out of git. If this repo is
# private, you can safely drop this line and commit it.
deploy/.user.ini

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generated by `netlify dev` for the edge-functions runtime. This project has no
# edge functions, so it is pure noise.
deno.lock

# Vendored by scripts/copy-tinymce.mjs on predev/prebuild - not source.
public/tinymce/
